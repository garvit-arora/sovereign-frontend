{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/login.html",
      "destination": "/login",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sovereign-we6b.onrender.com/api/:path*"
    },
    {
      "source": "/login",
      "destination": "/login/index.html"
    },
    {
      "source": "/evidence",
      "destination": "/app/index.html"
    },
    {
      "source": "/evidence/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    }
  ]
}
